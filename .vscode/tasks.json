{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android TV: Unit Tests",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [":app:testDebugUnitTest"],
      "options": {
        "cwd": "${workspaceFolder}\\android-tv"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Shared Code: Tests",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
