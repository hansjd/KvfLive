{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android TV: Unit Tests",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [":app:testDebugUnitTest"],
      "options": {
        "cwd": "${workspaceFolder}\\android-tv"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Shared Code: Tests",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Apple TV: Unit Tests",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-project",
        "KvfLiveAppleTV.xcodeproj",
        "-scheme",
        "KvfLiveAppleTV",
        "-destination",
        "platform=tvOS Simulator,name=Apple TV 4K (3rd generation)",
        "CODE_SIGNING_ALLOWED=NO",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\apple-tv"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
